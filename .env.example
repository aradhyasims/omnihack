# ---------------------------------------------------------------------------
# OmniHack environment configuration. Copy to `.env` and adjust.
# Never commit real secrets. In production, inject from AWS Secrets Manager / SSM.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Public base URL (used for canonical URLs, emails, QR codes, sitemap)
APP_URL=http://localhost:3000

# PostgreSQL connection string. Dev default matches scripts/dev-db.mjs (embedded PostgreSQL).
DATABASE_URL=postgresql://omnihack:omnihack@localhost:5433/omnihack_dev?schema=public

# 32+ byte random secret used to sign file URLs and invitation/check-in tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-in-every-environment-to-a-long-random-value

# 32-byte key (base64) for encrypting MFA secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Session lifetime in hours (sliding expiry) and absolute max lifetime in days.
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=14

# Require MFA for platform administrators (true in production).
REQUIRE_ADMIN_MFA=false

# --- Email -----------------------------------------------------------------
# EMAIL_PROVIDER=console  -> messages stored in the outbox table and logged (development)
# EMAIL_PROVIDER=resend   -> Resend HTTP API (recommended); the EMAIL_FROM domain must be verified in Resend
#                            RESEND_API_KEY=re_...   (a "sending access" key)
# EMAIL_PROVIDER=smtp     -> real delivery via any SMTP server (Resend SMTP, Postmark, Mailgun, ...)
EMAIL_PROVIDER=console
EMAIL_FROM="OmniHack <no-reply@omnihack.tech>"
# RESEND_API_KEY=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587               # 465 with SMTP_SECURE=true for implicit TLS
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_ALLOW_INSECURE=false   # true ONLY for a local test server without TLS

# --- File storage -----------------------------------------------------------
# STORAGE_DRIVER=local -> private directory on disk (single instance or shared volume)
# STORAGE_DRIVER=s3    -> Amazon S3 / S3-compatible; credentials from the AWS chain (ECS task role)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25
# S3_BUCKET=omnihack-production-files
# S3_REGION=ap-south-1
# S3_SSE=aws:kms              # or AES256
# S3_KMS_KEY_ID=
# S3_ENDPOINT=                # only for S3-compatible stores (e.g. MinIO)
# S3_FORCE_PATH_STYLE=false

# Malware scanning: none | clamav. With clamav, uploads stay PENDING (not downloadable) until clamd
# reports CLEAN; INFECTED files are deleted and the uploader is notified.
MALWARE_SCANNER=none
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- Data retention (days; daily purge by the worker) ------------------------
# RETENTION_EMAIL_DAYS=90
# RETENTION_NOTIFICATION_DAYS=365
# RETENTION_JOB_DAYS=30
# RETENTION_AUDIT_DAYS=730

# --- Optional modules (disabled unless configured) --------------------------
# Payments stay disabled until a provider and webhook secret are configured.
PAYMENTS_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=

# AI assistance stays disabled until a provider is configured.
AI_PROVIDER=
AI_API_KEY=

# Seed demo data (development only; refuses to run when NODE_ENV=production)
SEED_ADMIN_PASSWORD=OmniHack!Demo2026
